{
    "name": "hypoid/lavacharts",
    "description": "PHP wrapper library for the Google Chart API forker",
    "version": "3.6",
    "keywords": [
        "charts",
        "graphs",
        "google",
        "laravel",
        "symfony"
    ],
    "homepage": "http://lavacharts.com",
    "license": "MIT",
    "authors": [
        {
        "name": "Martial AUCLERC",
        "email": "martialus87@free.fr",
        "role": "Mainteneur and updateur Laravel 12"
        },
        {
            "name": "Kevin Hill",
            "email": "kevinkhill@gmail.com",
            "role": "Creator"
        }
    ],
    "support": {
        "docs": "http://lavacharts.com",
        "wiki": "https://github.com/martialus87/lavacharts/wiki",
        "source": "https://github.com/martialus87/lavacharts",
        "issues": "https://github.com/martialus87/lavacharts/issues"
    },
    "suggest": {
        "khill/datatableplus": "Adds extra features to DataTables such as csv and laravel collection parsing."
    },
    "require": {
        "php": ">=8.3",
        "nesbot/carbon": ">=3.0 <6.0",
        "twig/twig": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Hypoid\\Lavacharts\\": "src/"
        }
    },
    
   
    
    "require-dev": {
        
    },
    "autoload-dev": {
        "psr-4": {
            "Hypoid\\Lavacharts\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml",
        "cs": "phpcs --standard=PSR2 src tests",
        "cbf" : "phpcbf --standard=PSR2 src tests",
        "version": "php -r \"require(__DIR__.\\\"/src/Lavacharts.php\\\");echo \\Hypoid\\Lavacharts\\Lavacharts::VERSION;\"",
        "lavajs:release" : "gulp --cwd javascript release && git add javascript/dist/lava.js && git commit -m 'Releasing new build of the lava.js module' && git push",
        "lavajs:gulp" : "gulp --cwd javascript",
        "lavajs:pull" : "git subtree --prefix=javascript pull lavajs master",
        "lavajs:push" : "git subtree --prefix=javascript push lavajs master"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Hypoid\\Lavacharts\\Laravel\\LavachartsServiceProvider"
            ],
            "aliases": {
                "Lava": "Hypoid\\Lavacharts\\Laravel\\LavachartsFacade"
            }
        }
    },
    "config": {
        "platform": {
            "php": "8.3"
        }
    },
    "minimum-stability": "stable"
}
